    <script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{"colors":{"tertiary-fixed":"#d5e4f2","on-primary":"#ffffff","surface-container-highest":"#d3e4fe","primary-container":"#7857f8","on-primary-container":"#fffbff","tertiary":"#4f5e69","on-tertiary-fixed":"#0f1d27","outline-variant":"#c9c4d8","surface-container-lowest":"#ffffff","surface-tint":"#613de0","on-tertiary-container":"#fcfcff","surface-container-low":"#eff4ff","secondary":"#5e5c70","primary-fixed":"#e6deff","surface-variant":"#d3e4fe","secondary-fixed":"#e4e0f8","error":"#ba1a1a","on-secondary":"#ffffff","tertiary-container":"#687682","primary":"#5f3add","surface-bright":"#f8f9ff","secondary-fixed-dim":"#c7c4db","on-surface-variant":"#484555","on-tertiary-fixed-variant":"#3a4853","on-tertiary":"#ffffff","inverse-on-surface":"#eaf1ff","surface-container-high":"#dce9ff","error-container":"#ffdad6","secondary-container":"#e4e0f8","outline":"#797587","inverse-surface":"#213145","surface-container":"#e5eeff","surface":"#f8f9ff","on-secondary-fixed":"#1b1a2b","on-primary-fixed":"#1c0062","on-surface":"#0b1c30","on-secondary-container":"#646276","on-background":"#0b1c30","on-primary-fixed-variant":"#4918c8","background":"#f8f9ff","on-secondary-fixed-variant":"#464558","on-error":"#ffffff","inverse-primary":"#cabeff","surface-dim":"#cbdbf5","tertiary-fixed-dim":"#b9c8d6","on-error-container":"#93000a","primary-fixed-dim":"#cabeff"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"margin-desktop":"2.5rem","space-sm":"0.75rem","space-md":"1rem","space-2xl":"2.5rem","space-3xl":"3.5rem","space-lg":"1.5rem","gutter":"1.5rem","space-xs":"0.5rem","space-xxs":"0.25rem","margin-mobile":"1rem","space-xl":"2rem"},"fontFamily":{"display-lg-mobile":["Plus Jakarta Sans"],"body-lg":["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"code-sm":["JetBrains Mono"],"headline-sm":["Plus Jakarta Sans"],"headline-lg-mobile":["Plus Jakarta Sans"],"title-md":["Plus Jakarta Sans"],"body-sm":["Plus Jakarta Sans"],"body-md":["Plus Jakarta Sans"],"label-md":["Plus Jakarta Sans"],"display-lg":["Plus Jakarta Sans"],"headline-md":["Plus Jakarta Sans"],"label-sm":["Plus Jakarta Sans"]},"fontSize":{"display-lg-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"700"}],"body-lg":["16px",{"lineHeight":"26px","letterSpacing":"0em","fontWeight":"400"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"code-sm":["12px",{"lineHeight":"18px","letterSpacing":"0em","fontWeight":"400"}],"headline-sm":["20px",{"lineHeight":"28px","letterSpacing":"-0.01em","fontWeight":"600"}],"headline-lg-mobile":["26px",{"lineHeight":"34px","letterSpacing":"-0.015em","fontWeight":"600"}],"title-md":["16px",{"lineHeight":"24px","letterSpacing":"-0.005em","fontWeight":"600"}],"body-sm":["13px",{"lineHeight":"18px","letterSpacing":"0.005em","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"22px","letterSpacing":"0em","fontWeight":"400"}],"label-md":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"500"}],"display-lg":["44px",{"lineHeight":"52px","letterSpacing":"-0.025em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"label-sm":["12px",{"lineHeight":"16px","letterSpacing":"0.02em","fontWeight":"500"}]}}}}</script>
