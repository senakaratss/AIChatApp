<body class="bg-background font-body-md text-on-surface min-h-screen flex flex-col relative selection:bg-primary-fixed selection:text-on-primary-fixed">
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden"><div class="absolute -top-[20%] -left-[10%] w-[55vw] h-[55vw] rounded-full bg-secondary-fixed/40 blur-[130px]"></div><div class="absolute top-[10%] -right-[15%] w-[50vw] h-[50vw] rounded-full bg-surface-container-high/60 blur-[140px]"></div><div class="absolute -bottom-[20%] left-[20%] w-[60vw] h-[60vw] rounded-full bg-primary-fixed/30 blur-[150px]"></div></div>
    <header class="fixed top-0 w-full z-50 bg-surface/75 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.03)]"><div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between"><a class="flex items-center gap-space-xs group" data-path="login" href="#"><div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary via-primary-container to-secondary flex items-center justify-center shadow-[0_4px_16px_rgba(95,58,221,0.22)]"><span class="material-symbols-outlined text-on-primary text-[20px]">auto_awesome</span></div><div class="flex flex-col"><span class="font-headline-sm text-headline-sm tracking-tight text-on-surface leading-none">Aura<span class="text-primary font-headline-sm">AI</span></span><span class="font-label-sm text-label-sm text-on-surface-variant font-medium tracking-wide">Intelligence Canvas</span></div></a><nav class="hidden md:flex items-center gap-space-xs" data-active-classes="bg-surface-container text-primary font-label-md rounded-lg"><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-space-sm py-space-xs rounded-lg transition-colors" data-path="login" href="#">Sign In</a><a aria-current="page" class="px-space-sm py-space-xs transition-colors bg-surface-container text-primary font-label-md rounded-lg" data-path="register" href="#">Create Account</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-space-sm py-space-xs rounded-lg transition-colors" data-path="sso-portal" href="#">Enterprise SSO</a></nav><div class="flex items-center gap-space-sm"><div class="relative flex items-center bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xxs rounded-full shadow-[0_1px_6px_rgba(100,100,150,0.06)]"><span class="material-symbols-outlined text-on-surface-variant text-[16px] mr-1.5">language</span><select aria-label="Select language and region" class="bg-transparent font-label-sm text-label-sm