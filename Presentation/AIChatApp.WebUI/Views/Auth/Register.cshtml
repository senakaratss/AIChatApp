        </div>
        <script>
            (function initRegistrationLogic() {
              const passwordInput = document.getElementById('Password');
              const confirmPasswordInput = document.getElementById('ConfirmPassword');
              const toggleBtn = document.getElementById('togglePassword');
              const eyeIcon = document.getElementById('eyeIcon');
              const matchIcon = document.getElementById('matchIcon');
              const matchMessage = document.getElementById('matchMessage');

              const meters = [
                document.getElementById('meter1'),
                document.getElementById('meter2'),
                document.getElementById('meter3'),
                document.getElementById('meter4')
              ];
              const strengthText = document.getElementById('strengthText');

              if (toggleBtn && passwordInput && eyeIcon) {
                toggleBtn.addEventListener('click', () => {
                  const isPassword = passwordInput.getAttribute('type') === 'password';
                  passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                  eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
                });
              }

              function evaluatePassword(val) {
                if (!val) return 0;
                let score = 0;
                if (val.length >= 8) score += 1;
                if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score += 1;
                if (/\d/.test(val)) score += 1;
                if (/[^A-Za-z0-9]/.test(val)) score += 1;
                return score;
              }

              if (passwordInput) {
                passwordInput.addEventListener('input', (e) => {
                  const val = e.target.value;
                  const score = evaluatePassword(val);

                  meters.forEach((meter) => {
                    meter.className = 'h-1 rounded-full bg-surface-variant transition-colors duration-300';
                  });

                  if (score === 0) {
                    strengthText.textContent = 'Enter password';
                    strengthText.className = 'font-medium text-tertiary text-[11px]';
                  } else if (score === 1) {
                    meters[0].classList.replace('bg-surface-variant', 'bg-error');
                    strengthText.textContent = 'Weak';
                    strengthText.className = 'font-medium text-error text-[11px]';
                  } else if (score === 2) {
                    meters[0].classList.replace('bg-surface-variant', 'bg-secondary');
                    meters[1].classList.replace('bg-surface-variant', 'bg-secondary');
                    strengthText.textContent = 'Fair';
                    strengthText.className = 'font-medium text-secondary text-[11px]';
                  } else if (score === 3) {
                    meters[0].classList.replace('bg-surface-variant', 'bg-primary-container');
                    meters[1].classList.replace('bg-surface-variant', 'bg-primary-container');
                    meters[2].classList.replace('bg-surface-variant', 'bg-primary-container');
                    strengthText.textContent = 'Good';
                    strengthText.className = 'font-medium text-primary text-[11px]';
                  } else {
                    meters.forEach(meter => {
                      meter.classList.replace('bg-surface-variant', 'bg-primary');
                    });
                    strengthText.textContent = 'Strong password';
                    strengthText.className = 'font-medium text-primary font-bold text-[11px]';
                  }

                  validatePasswordMatch();
                });
              }

              function validatePasswordMatch() {
                if (!confirmPasswordInput) return;
                const pwd = passwordInput.value;
                const cpwd = confirmPasswordInput.value;

                if (!cpwd) {
                  matchIcon.className = 'material-symbols-outlined absolute right-3 text-[19px] text-surface-variant transition-colors';
                  matchMessage.classList.add('hidden');
                  return;
                }

                if (pwd === cpwd) {
                  matchIcon.className = 'material-symbols-outlined absolute right-3 text-[19px] text-primary transition-colors';
                  matchMessage.textContent = 'Passwords match';
                  matchMessage.className = 'text-[11px] font-label-sm font-medium text-primary';
                  matchMessage.classList.remove('hidden');
                } else {
                  matchIcon.className = 'material-symbols-outlined absolute right-3 text-[19px] text-error transition-colors';
                  matchMessage.textContent = 'Passwords do not match';
                  matchMessage.className = 'text-[11px] font-label-sm font-medium text-error';
                  matchMessage.classList.remove('hidden');
                }
              }

              if (confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', validatePasswordMatch);
              }
            })();
        </script>
