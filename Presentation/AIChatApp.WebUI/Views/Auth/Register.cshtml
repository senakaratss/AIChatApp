                                        <span class="material-symbols-outlined absolute left-3 text-secondary text-[19px] pointer-events-none">badge</span>
                                        <input asp-for="Surname" class="w-full bg-surface-container-lowest rounded-xl pl-9 pr-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline-variant shadow-[0_2px_8px_rgba(100,100,150,0.04)] focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-bright transition-all duration-200" id="LastName" placeholder="Rostova" required="" type="text" />
                                    </div>
                                </div>
                            </div>
                            <!-- Email Address -->
                            <div class="flex flex-col gap-1.5">
                                <label class="font-label-sm text-label-sm text-on-surface" for="Email">Work Email</label>
                                <div class="relative flex items-center">
                                    <span class="material-symbols-outlined absolute left-3 text-secondary text-[19px] pointer-events-none">mail</span>
                                    <input asp-for="Email" class="w-full bg-surface-container-lowest rounded-xl pl-9 pr-3.5 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline-variant shadow-[0_2px_8px_rgba(100,100,150,0.04)] focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-bright transition-all duration-200" id="Email" placeholder="elena.rostova@enterprise.com" required="" type="email" />
                                </div>
                            </div>
                            <!-- Password Field -->
                            <div class="flex flex-col gap-1.5">
                                <label class="font-label-sm text-label-sm text-on-surface" for="Password">Password</label>
                                <div class="relative flex items-center">
                                    <span class="material-symbols-outlined absolute left-3 text-secondary text-[19px] pointer-events-none">lock</span>
                                    <input asp-for="Password" class="w-full bg-surface-container-lowest rounded-xl pl-9 pr-10 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline-variant shadow-[0_2px_8px_rgba(100,100,150,0.04)] focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-bright transition-all duration-200" id="Password" placeholder="Create a strong password" required="" type="password" />
                                    <button aria-label="Toggle password visibility" class="absolute right-3 text-secondary hover:text-on-surface transition-colors focus:outline-none flex items-center" id="togglePassword" type="button">
                                        <span class="material-symbols-outlined text-[19px]" id="eyeIcon">visibility</span>
                                    </button>
                                </div>
                                <!-- Dynamic Password Strength Indicator -->
                                <div class="pt-1.5 flex flex-col gap-1.5">
                                    <div class="grid grid-cols-4 gap-1.5 w-full">
                                        <div class="h-1 rounded-full bg-surface-variant transition-colors duration-300" id="meter1"></div>
                                        <div class="h-1 rounded-full bg-surface-variant transition-colors duration-300" id="meter2"></div>
                                        <div class="h-1 rounded-full bg-surface-variant transition-colors duration-300" id="meter3"></div>
                                        <div class="h-1 rounded-full bg-surface-variant transition-colors duration-300" id="meter4"></div>
                                    </div>
                                    <div class="flex items-center justify-between font-label-sm text-label-sm">
                                        <span class="text-on-surface-variant text-[11px]">Password Strength</span>
                                        <span class="font-medium text-tertiary text-[11px]" id="strengthText">Enter password</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Confirm Password Field -->
                            <div class="flex flex-col gap-1.5">
                                <label class="font-label-sm text-label-sm text-on-surface" for="ConfirmPassword">Confirm Password</label>
                                <div class="relative flex items-center">
                                    <span class="material-symbols-outlined absolute left-3 text-secondary text-[19px] pointer-events-none">verified_user</span>
                                    <input asp-for="ConfirmPassword" class="w-full bg-surface-container-lowest rounded-xl pl-9 pr-10 py-2.5 font-body-md text-body-md text-on-surface placeholder:text-outline-variant shadow-[0_2px_8px_rgba(100,100,150,0.04)] focus:outline-none focus:ring-2 focus:ring-primary/40 focus:bg-surface-bright transition-all duration-200" id="ConfirmPassword" placeholder="Re-enter password" required="" type="password" />
                                    <span class="material-symbols-outlined absolute right-3 text-[19px] text-surface-variant transition-colors" id="matchIcon">check_circle</span>
                                </div>
