@using AIChatApp.Application.Dtos
@model LoginDto
@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        @@layer base {
            html, body {
                margin: 0;
                padding: 0;
            }

            body {
                overscroll-behavior: none;
            }

            main > :first-child {
                margin-top: 0 !important;
            }

            main > :last-child {
                margin-bottom: 0 !important;
            }
        }

        ::-webkit-scrollbar {
            display: none;
        }</style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">tailwind.config={darkMode:"class",theme:{extend:{"colors":{"tertiary-fixed":"#d5e4f2","on-primary":"#ffffff","surface-container-highest":"#d3e4fe","primary-container":"#7857f8","on-primary-container":"#fffbff","tertiary":"#4f5e69","on-tertiary-fixed":"#0f1d27","outline-variant":"#c9c4d8","surface-container-lowest":"#ffffff","surface-tint":"#613de0","on-tertiary-container":"#fcfcff","surface-container-low":"#eff4ff","secondary":"#5e5c70","primary-fixed":"#e6deff","surface-variant":"#d3e4fe","secondary-fixed":"#e4e0f8","error":"#ba1a1a","on-secondary":"#ffffff","tertiary-container":"#687682","primary":"#5f3add","surface-bright":"#f8f9ff","secondary-fixed-dim":"#c7c4db","on-surface-variant":"#484555","on-tertiary-fixed-variant":"#3a4853","on-tertiary":"#ffffff","inverse-on-surface":"#eaf1ff","surface-container-high":"#dce9ff","error-container":"#ffdad6","secondary-container":"#e4e0f8","outline":"#797587","inverse-surface":"#213145","surface-container":"#e5eeff","surface":"#f8f9ff","on-secondary-fixed":"#1b1a2b","on-primary-fixed":"#1c0062","on-surface":"#0b1c30","on-secondary-container":"#646276","on-background":"#0b1c30","on-primary-fixed-variant":"#4918c8","background":"#f8f9ff","on-secondary-fixed-variant":"#464558","on-error":"#ffffff","inverse-primary":"#cabeff","surface-dim":"#cbdbf5","tertiary-fixed-dim":"#b9c8d6","on-error-container":"#93000a","primary-fixed-dim":"#cabeff"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"margin-desktop":"2.5rem","space-sm":"0.75rem","space-md":"1rem","space-2xl":"2.5rem","space-3xl":"3.5rem","space-lg":"1.5rem","gutter":"1.5rem","space-xs":"0.5rem","space-xxs":"0.25rem","margin-mobile":"1rem","space-xl":"2rem"},"fontFamily":{"display-lg-mobile":["Plus Jakarta Sans"],"body-lg":["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"code-sm":["JetBrains Mono"],"headline-sm":["Plus Jakarta Sans"],"headline-lg-mobile":["Plus Jakarta Sans"],"title-md":["Plus Jakarta Sans"],"body-sm":["Plus Jakarta Sans"],"body-md":["Plus Jakarta Sans"],"label-md":["Plus Jakarta Sans"],"display-lg":["Plus Jakarta Sans"],"headline-md":["Plus Jakarta Sans"],"label-sm":["Plus Jakarta Sans"]},"fontSize":{"display-lg-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"700"}],"body-lg":["16px",{"lineHeight":"26px","letterSpacing":"0em","fontWeight":"400"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"600"}],"code-sm":["12px",{"lineHeight":"18px","letterSpacing":"0em","fontWeight":"400"}],"headline-sm":["20px",{"lineHeight":"28px","letterSpacing":"-0.01em","fontWeight":"600"}],"headline-lg-mobile":["26px",{"lineHeight":"34px","letterSpacing":"-0.015em","fontWeight":"600"}],"title-md":["16px",{"lineHeight":"24px","letterSpacing":"-0.005em","fontWeight":"600"}],"body-sm":["13px",{"lineHeight":"18px","letterSpacing":"0.005em","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"22px","letterSpacing":"0em","fontWeight":"400"}],"label-md":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"500"}],"display-lg":["44px",{"lineHeight":"52px","letterSpacing":"-0.025em","fontWeight":"700"}],"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.015em","fontWeight":"600"}],"label-sm":["12px",{"lineHeight":"16px","letterSpacing":"0.02em","fontWeight":"500"}]}}}}</script>
</head>
<body class="bg-background font-body-md text-on-surface min-h-screen flex flex-col relative selection:bg-primary-fixed selection:text-on-primary-fixed">
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden"><div class="absolute -top-[20%] -left-[10%] w-[55vw] h-[55vw] rounded-full bg-secondary-fixed/40 blur-[130px]"></div><div class="absolute top-[10%] -right-[15%] w-[50vw] h-[50vw] rounded-full bg-surface-container-high/60 blur-[140px]"></div><div class="absolute -bottom-[20%] left-[20%] w-[60vw] h-[60vw] rounded-full bg-primary-fixed/30 blur-[150px]"></div></div>
    <header class="fixed top-0 w-full z-50 bg-surface/75 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.03)]"><div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between"><a class="flex items-center gap-space-xs group" data-path="login" href="#"><div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary via-primary-container to-secondary flex items-center justify-center shadow-[0_4px_16px_rgba(95,58,221,0.22)]"><span class="material-symbols-outlined text-on-primary text-[20px]">auto_awesome</span></div><div class="flex flex-col"><span class="font-headline-sm text-headline-sm tracking-tight text-on-surface leading-none">Aura<span class="text-primary font-headline-sm">AI</span></span><span class="font-label-sm text-label-sm text-on-surface-variant font-medium tracking-wide">Intelligence Canvas</span></div></a><nav class="hidden md:flex items-center gap-space-xs" data-active-classes="bg-surface-container text-primary font-label-md rounded-lg"><a aria-current="page" class="px-space-sm py-space-xs transition-colors bg-surface-container text-primary font-label-md rounded-lg" data-path="login" href="#">Sign In</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-space-sm py-space-xs rounded-lg transition-colors" data-path="register" href="#">Create Account</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-space-sm py-space-xs rounded-lg transition-colors" data-path="sso-portal" href="#">Enterprise SSO</a></nav><div class="flex items-center gap-space-sm"><div class="relative flex items-center bg-surface-container-lowest/80 backdrop-blur-md px-space-sm py-space-xxs rounded-full shadow-[0_1px_6px_rgba(100,100,150,0.06)]"><span class="material-symbols-outlined text-on-surface-variant text-[16px] mr-1.5">language</span><select aria-label="Select language and region" class="bg-transparent font-label-sm text-label-sm text-on-surface-variant focus:outline-none cursor-pointer pr-1"><option>EN · United States</option><option>ES · España</option><option>FR · France</option><option>DE · Deutschland</option><option>JA · 日本</option></select></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header>
    <main class="w-full pt-16 flex-1 flex flex-col items-center justify-center">
        <div class="flex flex-col w-full items-center justify-center py-space-xl px-4 sm:px-6">
            <div class="w-full max-w-[480px] relative">
                <!-- Ambient Luminous Halo Orbs (Parent Relative) -->
                <div class="absolute -top-12 -left-12 w-44 h-44 bg-primary-fixed/50 rounded-full blur-3xl pointer-events-none -z-10"></div>
                <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-surface-container-highest/60 rounded-full blur-3xl pointer-events-none -z-10"></div>
                <!-- Main Card Container -->
                <div class="bg-surface-container-lowest rounded-xl shadow-xl p-6 sm:p-space-xl flex flex-col relative overflow-hidden backdrop-blur-md">
                    <!-- Top Soft Aura Accent Bar -->
                    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-primary-fixed via-primary to-primary-container"></div>
                    <!-- Header Section -->
                    <div class="flex flex-col items-center text-center mt-space-xs mb-space-lg">
                        <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary mb-space-sm shadow-sm">
                            <span class="material-symbols-outlined text-[26px]">lock_open</span>
                        </div>
                        <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">Welcome back</h1>
                        <p class="font-body-md text-body-md text-on-surface-variant mt-1 max-w-[340px]">
                            Sign in to access your Aura AI workspace and conversations
                        </p>
                    </div>
                    <!-- Social Identity Providers -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-xs mb-space-md">
                        <!-- Google SSO -->
                        <button class="group flex items-center justify-center gap-space-xs bg-surface-container-low hover:bg-surface-container text-on-surface py-2.5 px-space-sm rounded-lg transition-all duration-200 shadow-sm hover:-translate-y-0.5" type="button">
                            <svg class="w-4 h-4 shrink-0" viewbox="0 0 24 24">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
                            </svg>
                            <span class="font-label-md text-label-md">Google</span>
                        </button>
                        <!-- Microsoft / GitHub SSO -->
                        <button class="group flex items-center justify-center gap-space-xs bg-surface-container-low hover:bg-surface-container text-on-surface py-2.5 px-space-sm rounded-lg transition-all duration-200 shadow-sm hover:-translate-y-0.5" type="button">
                            <svg class="w-4 h-4 shrink-0 text-on-surface" fill="currentColor" viewbox="0 0 24 24">
                                <path clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" fill-rule="evenodd"></path>
                            </svg>
                            <span class="font-label-md text-label-md">GitHub</span>
                        </button>
                    </div>
                    <!-- Delicate Pastel Divider -->
                    <div class="relative flex items-center justify-center my-space-sm">
                        <div class="w-full h-px bg-surface-container-high"></div>
                        <span class="absolute bg-surface-container-lowest px-3 font-label-sm text-label-sm text-on-surface-variant font-medium">or continue with email</span>
                    </div>
                    <!-- ASP.NET Core MVC Razor Form Pattern -->
                    <form class="flex flex-col gap-space-md mt-space-xs" id="loginForm" method="post" novalidate="">
                       <div asp-validation-summary="ModelOnly" class="text-error"></div>
                        <!-- Email Address Field -->
                        <div class="flex flex-col gap-1.5 text-left">
                            <div class="flex items-center justify-between">
                                <label asp-for="Email" class="font-label-md text-label-md text-on-surface font-semibold" for="Email">
                                    Email Address
                                </label>
                                <span class="font-label-sm text-label-sm text-primary hover:underline cursor-pointer" onclick="document.getElementById('Email').value='elena.rostova@enterprise.com'">Demo user</span>
                            </div>
                            <div class="relative flex items-center">
                                <span class="material-symbols-outlined absolute left-3.5 text-[20px] text-on-surface-variant pointer-events-none">mail</span>
                                <input asp-for="Email" class="w-full bg-surface-container-low focus:bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-11 pr-4 py-3 rounded-lg outline-none transition-all duration-200 placeholder:text-outline shadow-inner focus:shadow-[0_0_0_3px_rgba(95,58,221,0.18)]" placeholder="elena.rostova@enterprise.com" required="" type="email" />
                            </div>
                            <!-- ASP.NET Core Validation Message Slot -->
                            <span class="font-label-sm text-label-sm text-error hidden" data-valmsg-for="Email" id="emailError">
                                Please provide a valid corporate email address.
                            </span>
                        </div>
                        <!-- Password Field -->
                        <div class="flex flex-col gap-1.5 text-left">
                            <div class="flex items-center justify-between">
                                <label asp-for="Password" class="font-label-md text-label-md text-on-surface font-semibold" for="Password">
                                    Password
                                </label>
                                <a class="font-label-sm text-label-sm text-primary hover:text-primary-container transition-colors" data-path="forgot-password" href="#">
                                    Forgot password?
                                </a>
                            </div>
                            <div class="relative flex items-center">
                                <span class="material-symbols-outlined absolute left-3.5 text-[20px] text-on-surface-variant pointer-events-none">lock</span>
                                <input asp-for="Password" class="w-full bg-surface-container-low focus:bg-surface-container-lowest text-on-surface font-body-md text-body-md pl-11 pr-11 py-3 rounded-lg outline-none transition-all duration-200 placeholder:text-outline shadow-inner focus:shadow-[0_0_0_3px_rgba(95,58,221,0.18)]" placeholder="••••••••••••" required="" type="password" />
                                <button aria-label="Toggle password visibility" class="absolute right-3.5 flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer" id="togglePassword" type="button">
                                    <span class="material-symbols-outlined text-[20px]" id="eyeIcon">visibility</span>
                                </button>
                            </div>
                            <!-- ASP.NET Core Validation Message Slot -->
                            <span class="font-label-sm text-label-sm text-error hidden" data-valmsg-for="Password" id="passwordError">
                                Password is required.
                            </span>
                        </div>
                        <!-- Remember Me Checkbox -->
                        <div class="flex items-center justify-between mt-0.5">
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input class="sr-only peer" id="RememberMe" name="RememberMe" type="checkbox" />
                                <div class="w-5 h-5 rounded bg-surface-container-high peer-checked:bg-primary flex items-center justify-center transition-all duration-200 shadow-sm peer-focus-visible:shadow-[0_0_0_3px_rgba(95,58,221,0.25)]">
                                    <span class="material-symbols-outlined text-on-primary text-[16px] opacity-0 peer-checked:opacity-100 transition-opacity font-bold">check</span>
                                </div>
                                <span class="font-body-sm text-body-sm text-on-surface-variant">Remember this device for 30 days</span>
                            </label>
                        </div>
                        <!-- Primary CTA Button -->
                        <button class="w-full bg-gradient-to-r from-primary to-primary-container hover:from-primary-container hover:to-primary text-on-primary font-label-md text-label-md py-3.5 px-space-md rounded-lg shadow-md hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 hover:-translate-y-0.5 cursor-pointer mt-space-xs" id="submitBtn" type="submit">
                            <span id="btnText">Sign In to Aura</span>
                            <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-hover:translate-x-1" id="btnIcon">arrow_forward</span>
                        </button>
                    </form>
                    <!-- Bottom Account Switcher -->
                    <div class="mt-space-lg pt-space-md bg-surface-container-low/40 -mx-6 sm:-mx-space-xl px-6 sm:px-space-xl pb-1 flex flex-col items-center gap-space-sm text-center">
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Don't have an account?
                            <a class="font-label-sm text-label-sm text-primary hover:text-primary-container font-semibold transition-colors ml-1" data-path="register" href="#">
                                Create an account
                            </a>
                        </p>
                        <!-- Security Badge / Trust Notice -->
                        <div class="flex items-center justify-center gap-1.5 text-on-surface-variant py-2">
                            <span class="material-symbols-outlined text-tertiary text-[14px]">verified_user</span>
                            <span class="font-label-sm text-label-sm text-tertiary">256-bit TLS encrypted session • Enterprise Grade AI Security</span>
                        </div>
                    </div>
                </div>
                <!-- Micro Context Strip Below Card -->
                <div class="mt-space-md flex items-center justify-center gap-space-md text-center">
                    <div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm">
                        <span class="material-symbols-outlined text-[15px] text-primary">cloud_done</span>
                        <span>Aura Cloud Fabric</span>
                    </div>
                    <span class="inline-block w-1 h-1 rounded-full bg-outline-variant"></span>
                    <div class="flex items-center gap-1 text-on-surface-variant font-label-sm text-label-sm">
                        <span class="material-symbols-outlined text-[15px] text-secondary">terminal</span>
                        <span>Razor View Ready</span>
                    </div>
                </div>
            </div>
        </div>
        <script>
            (function () {
              const passwordInput = document.getElementById('Password');
              const toggleBtn = document.getElementById('togglePassword');
              const eyeIcon = document.getElementById('eyeIcon');
              const loginForm = document.getElementById('loginForm');
              const emailInput = document.getElementById('Email');
              const emailError = document.getElementById('emailError');
              const passwordError = document.getElementById('passwordError');
              const submitBtn = document.getElementById('submitBtn');
              const btnText = document.getElementById('btnText');
              const btnIcon = document.getElementById('btnIcon');

              if (toggleBtn && passwordInput && eyeIcon) {
                toggleBtn.addEventListener('click', function () {
                  const isPassword = passwordInput.getAttribute('type') === 'password';
                  passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                  eyeIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
                });
              }

              if (loginForm) {
                loginForm.addEventListener('submit', function (e) {
                  let isValid = true;

                  if (!emailInput.value.trim() || !emailInput.value.includes('@@')) {
                    emailError.classList.remove('hidden');
                    isValid = false;
                  } else {
                    emailError.classList.add('hidden');
                  }

                  if (!passwordInput.value.trim()) {
                    passwordError.classList.remove('hidden');
                    isValid = false;
                  } else {
                    passwordError.classList.add('hidden');
                  }

                  if (!isValid) {
                    e.preventDefault();
                  } else {
                    // Visual feedback during form submission
                    btnText.textContent = 'Authenticating...';
                    btnIcon.textContent = 'sync';
                    btnIcon.classList.add('animate-spin');
                    submitBtn.classList.add('opacity-90', 'pointer-events-none');
                  }
                });

                emailInput.addEventListener('input', function() {
                  if (emailError) emailError.classList.add('hidden');
                });
                passwordInput.addEventListener('input', function() {
                  if (passwordError) passwordError.classList.add('hidden');
                });
              }
            })();
        </script>
    </main>
    <footer class="w-full bg-surface-container-lowest/70 backdrop-blur-md shadow-[0_-1px_6px_rgba(0,0,0,0.02)] mt-auto py-space-md"><div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-space-sm"><div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm"><span>© 2025 Aura AI Inc. All rights reserved.</span><span class="inline-block w-1 h-1 rounded-full bg-outline-variant"></span><span class="text-tertiary font-code-sm text-code-sm">v2.4.0-cloud</span></div><div class="flex flex-wrap items-center justify-center gap-space-md"><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors" data-path="privacy-policy" href="#">Privacy Policy</a><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors" data-path="terms-of-service" href="#">Terms of Service</a><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors" data-path="support" href="#">Support</a><a class="font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface flex items-center gap-1 transition-colors" data-path="system-status" href="#"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>Systems Operational</a></div></div></footer>
</body>
</html>