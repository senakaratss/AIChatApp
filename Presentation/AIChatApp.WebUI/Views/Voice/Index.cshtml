@{
    ViewData["Title"] = "Sesli Sohbet";
    ViewData["ChatTitle"] = "Sesli Oturum";
    Layout = "~/Views/Shared/_ChatLayout.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,460&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        .voice-page {
            --v-bg: var(--color-bg); 
            --v-bg-deep: var(--color-border-soft);

            --v-panel-line: rgba(27, 24, 48, 0.1);
            --v-ink: #1b1830;
            --v-ink-dim: #726e8c;
            --v-violet: #6d5cff;
            --v-violet-soft: rgba(109, 92, 255, 0.35);
            --v-teal: #14b89a;
            --v-teal-soft: rgba(20, 184, 154, 0.35);
            --v-danger: #ff5470;
            --v-danger-soft: rgba(255, 84, 112, 0.38);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            height: 100%;
            min-height: 0;
            padding: 0 24px 30px;
            color: var(--v-ink);
            background: var(--v-bg);
            overflow: hidden;
            font-family: "JetBrains Mono", ui-monospace, monospace;
        }

        .voice-atmosphere {
            position: absolute;
            inset: 0;
            z-index: 0;
            background: radial-gradient(50% 38% at 50% 28%, rgba(109, 92, 255, 0.10) 0%, rgba(109, 92, 255, 0) 72%), radial-gradient(42% 30% at 80% 86%, rgba(20, 184, 154, 0.08) 0%, rgba(20, 184, 154, 0) 74%), radial-gradient(60% 40% at 16% 92%, rgba(109, 92, 255, 0.05) 0%, rgba(109, 92, 255, 0) 72%), var(--v-bg);
            transition: background 1.4s ease;
        }

            .voice-atmosphere::after {
                content: "";
                position: absolute;
                inset: 0;
                opacity: 0.035;
                mix-blend-mode: multiply;
                background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
            }

        body.voice-listening .voice-atmosphere {
            background: radial-gradient(50% 40% at 50% 28%, rgba(20, 184, 154, 0.14) 0%, rgba(20, 184, 154, 0) 74%), radial-gradient(42% 30% at 80% 86%, rgba(20, 184, 154, 0.07) 0%, rgba(20, 184, 154, 0) 74%), radial-gradient(60% 40% at 16% 92%, rgba(109, 92, 255, 0.04) 0%, rgba(109, 92, 255, 0) 72%), var(--v-bg);
        }

        body.voice-speaking .voice-atmosphere {
            background: radial-gradient(55% 42% at 50% 26%, rgba(109, 92, 255, 0.15) 0%, rgba(109, 92, 255, 0) 76%), radial-gradient(46% 34% at 80% 86%, rgba(20, 184, 154, 0.11) 0%, rgba(20, 184, 154, 0) 76%), var(--v-bg);
        }

        /* ---------- üst durum şeridi ---------- */

        .voice-status-row {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 560px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 4px 0;
        }

        .voice-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 7px 14px 7px 11px;
            border-radius: 999px;
            background: #ffffff;
            border: 1px solid var(--v-panel-line);
            box-shadow: 0 1px 2px rgba(27, 24, 48, 0.05);
            font-size: 12.5px;
            font-weight: 500;
            letter-spacing: 0.01em;
            color: var(--v-ink);
        }

            .voice-status-pill .pulse-dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--v-teal);
                box-shadow: 0 0 0 0 rgba(43, 217, 174, 0.5);
                animation: dotPulse 2.2s ease-out infinite;
            }

        @@keyframes dotPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(43, 217, 174, 0.45);
            }

            70% {
                box-shadow: 0 0 0 7px rgba(43, 217, 174, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(43, 217, 174, 0);
            }
        }

        .voice-timer {
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 12.5px;
            letter-spacing: 0.03em;
            color: var(--v-ink-dim);
            font-variant-numeric: tabular-nums;
            background: #ffffff;
            border: 1px solid var(--v-panel-line);
            box-shadow: 0 1px 2px rgba(27, 24, 48, 0.05);
            padding: 7px 12px;
            border-radius: 999px;
        }

        /* ---------- merkez: aura halkası ---------- */

        .voice-center {
            position: relative;
            z-index: 1;
            flex: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 30px;
            min-height: 0;
        }

        .voice-orb-wrap {
            position: relative;
            width: 232px;
            height: 232px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .voice-orb-ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 1px solid rgba(109, 92, 255, 0.16);
            transition: border-color 0.8s ease;
        }

        .voice-orb-ring--2 {
            inset: 24px;
            border-color: rgba(109, 92, 255, 0.22);
            animation: ringBreathe 4.8s ease-in-out infinite;
        }

        .voice-orb-ring--3 {
            inset: 48px;
            border-color: rgba(20, 184, 154, 0.2);
            animation: ringBreathe 4.8s ease-in-out infinite 0.4s;
        }

        body.voice-listening .voice-orb-ring--2,
        body.voice-listening .voice-orb-ring--3 {
            border-color: rgba(20, 184, 154, 0.4);
            animation-duration: 2.6s;
        }

        body.voice-speaking .voice-orb-ring--2,
        body.voice-speaking .voice-orb-ring--3 {
            border-color: rgba(109, 92, 255, 0.4);
            animation-duration: 2.2s;
        }

        body.voice-thinking .voice-orb-ring--2,
        body.voice-thinking .voice-orb-ring--3 {
            animation: ringOrbit 5.5s linear infinite;
        }

        @@keyframes ringBreathe {
            0%, 100% {
                transform: scale(1);
                opacity: 0.55;
            }

            50% {
                transform: scale(1.07);
                opacity: 1;
            }
        }

        @@keyframes ringOrbit {
            0% {
                transform: rotate(0deg) scale(1);
            }

            50% {
                transform: rotate(180deg) scale(1.03);
            }

            100% {
                transform: rotate(360deg) scale(1);
            }
        }

        .voice-orb-core {
            position: relative;
            width: 124px;
            height: 124px;
            border-radius: 50%;
            background: conic-gradient(from 200deg, var(--v-violet), var(--v-teal), var(--v-violet));
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5) inset, 0 0 46px -10px var(--v-violet-soft), 0 18px 40px -16px rgba(27, 24, 48, 0.28);
            animation: orbBreathe 3.6s ease-in-out infinite;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: box-shadow 0.8s ease;
        }

            .voice-orb-core::before {
                content: "";
                position: absolute;
                inset: 9px;
                border-radius: 50%;
                background: #ffffff;
            }

            .voice-orb-core::after {
                content: "";
                position: absolute;
                inset: 9px;
                border-radius: 50%;
                background: radial-gradient(circle at 32% 28%, rgba(135, 120, 255, 0.35), rgba(135, 120, 255, 0) 60%);
            }

        @@keyframes orbBreathe {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.045);
            }
        }

        body.voice-listening .voice-orb-core {
            animation-duration: 1.8s;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5) inset, 0 0 54px -8px var(--v-teal-soft), 0 18px 40px -16px rgba(27, 24, 48, 0.28);
        }

        body.voice-speaking .voice-orb-core {
            animation-duration: 1.5s;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5) inset, 0 0 60px -6px var(--v-violet-soft), 0 18px 40px -16px rgba(27, 24, 48, 0.28);
        }

        body.voice-thinking .voice-orb-core {
            animation: orbBreathe 3.6s ease-in-out infinite, orbSpin 5.5s linear infinite;
        }

        @@keyframes orbSpin {
            from {
                filter: hue-rotate(0deg);
            }

            to {
                filter: hue-rotate(24deg);
            }
        }

        .voice-orb-mark {
            position: relative;
            z-index: 1;
            width: 19px;
            height: 19px;
            opacity: 0.92;
        }

            .voice-orb-mark path {
                fill: var(--v-violet);
            }

        /* mini dalga formu — orb'un hemen altında, konuşma genliğinin izlenimi */

        .voice-waveform {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 26px;
            opacity: 0.35;
            transition: opacity 0.6s ease;
        }

        body.voice-listening .voice-waveform,
        body.voice-speaking .voice-waveform {
            opacity: 1;
        }

        .voice-waveform span {
            width: 3px;
            border-radius: 2px;
            background: linear-gradient(180deg, var(--v-teal), var(--v-violet));
            animation: wf 1.4s ease-in-out infinite;
            animation-play-state: paused;
        }

        body.voice-listening .voice-waveform span,
        body.voice-speaking .voice-waveform span {
            animation-play-state: running;
        }

        body.voice-speaking .voice-waveform span {
            animation-duration: 0.9s;
        }

        .voice-waveform span:nth-child(1) {
            height: 9px;
            animation-delay: -1.1s;
        }

        .voice-waveform span:nth-child(2) {
            height: 20px;
            animation-delay: -0.9s;
        }

        .voice-waveform span:nth-child(3) {
            height: 13px;
            animation-delay: -1.3s;
        }

        .voice-waveform span:nth-child(4) {
            height: 26px;
            animation-delay: -0.4s;
        }

        .voice-waveform span:nth-child(5) {
            height: 11px;
            animation-delay: -0.7s;
        }

        .voice-waveform span:nth-child(6) {
            height: 22px;
            animation-delay: -1.0s;
        }

        .voice-waveform span:nth-child(7) {
            height: 15px;
            animation-delay: -0.2s;
        }

        .voice-waveform span:nth-child(8) {
            height: 24px;
            animation-delay: -0.6s;
        }

        .voice-waveform span:nth-child(9) {
            height: 9px;
            animation-delay: -1.4s;
        }

        @@keyframes wf {
            0%, 100% {
                transform: scaleY(0.4);
            }

            50% {
                transform: scaleY(1);
            }
        }

        /* ---------- canlı altyazı ---------- */

        .voice-caption {
            max-width: 460px;
            min-height: 56px;
            text-align: center;
            font-family: "Fraunces", ui-serif, Georgia, serif;
            font-size: 19px;
            font-weight: 460;
            line-height: 1.5;
            letter-spacing: 0.001em;
            color: var(--v-ink);
            padding: 0 14px;
        }

            .voice-caption .caret {
                display: inline-block;
                width: 2px;
                height: 17px;
                margin-left: 2px;
                background: var(--v-teal);
                vertical-align: -3px;
                animation: caretBlink 1s step-start infinite;
            }

        @@keyframes caretBlink {
            50% {
                opacity: 0;
            }
        }

        /* Aura konuşurken, gelen cevabın tamamı altta metin olarak akmasın —
                   sadece durumu belirten sabit, kısa bir ifade görünsün. */
        .voice-speaking-indicator {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 3px;
            font-family: "Fraunces", ui-serif, Georgia, serif;
            font-size: 19px;
            font-weight: 460;
            color: var(--v-ink-dim);
        }

            .voice-speaking-indicator .dot {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--v-violet);
                animation: speakingDot 1.2s ease-in-out infinite;
            }

                .voice-speaking-indicator .dot:nth-child(2) {
                    animation-delay: 0.15s;
                }

                .voice-speaking-indicator .dot:nth-child(3) {
                    animation-delay: 0.3s;
                }

        @@keyframes speakingDot {
            0%, 60%, 100% {
                opacity: 0.3;
                transform: translateY(0);
            }

            30% {
                opacity: 1;
                transform: translateY(-2px);
            }
        }

        body.voice-speaking .voice-caption {
            display: none;
        }

        body.voice-speaking .voice-speaking-indicator {
            display: inline-flex;
        }

        /* ---------- alt kontrol çubuğu ---------- */

        .voice-controls {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 560px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 20px;
        }

        .voice-btn--end {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 66px;
            height: 66px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            background: linear-gradient(155deg, var(--v-violet), #6c5ce0);
            box-shadow: 0 14px 30px -12px rgba(135, 120, 255, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
            transition: transform 0.15s ease, box-shadow 0.3s ease, background 0.3s ease;
        }

            .voice-btn--end svg {
                width: 24px;
                height: 24px;
                position: relative;
                z-index: 1;
            }

            .voice-btn--end:hover {
                transform: translateY(-1px);
            }

            .voice-btn--end:focus-visible {
                outline: 2px solid var(--v-teal);
                outline-offset: 4px;
            }

            .voice-btn--end::before {
                content: "";
                position: absolute;
                inset: -10px;
                border-radius: 50%;
                border: 1px solid rgba(135, 120, 255, 0.35);
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .voice-btn--end.is-active {
                background: linear-gradient(155deg, var(--v-danger), #e0405a);
                box-shadow: 0 14px 30px -12px var(--v-danger-soft), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
            }

                .voice-btn--end.is-active::before {
                    opacity: 1;
                    border-color: rgba(255, 92, 114, 0.4);
                    animation: btnPing 1.8s ease-out infinite;
                }

        @@keyframes btnPing {
            0% {
                transform: scale(1);
                opacity: 0.6;
            }

            100% {
                transform: scale(1.4);
                opacity: 0;
            }
        }

        /* ---------- yazıya geç bağlantısı ---------- */

        .voice-switch-mode {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 18px;
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 12.5px;
            color: var(--v-ink-dim);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color 0.15s ease, border-color 0.15s ease;
        }

            .voice-switch-mode:hover {
                color: var(--v-ink);
                border-color: rgba(255, 255, 255, 0.25);
            }

            .voice-switch-mode:focus-visible {
                outline: 2px solid var(--v-teal);
                outline-offset: 3px;
                border-radius: 2px;
            }

        @@media (max-width: 560px) {
            .voice-orb-wrap {
                width: 186px;
                height: 186px;
            }

            .voice-orb-core {
                width: 100px;
                height: 100px;
            }

            .voice-caption {
                font-size: 17px;
            }

            .voice-btn--end {
                width: 60px;
                height: 60px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .voice-orb-core,
            .voice-orb-ring--2,
            .voice-orb-ring--3,
            .voice-waveform span,
            .voice-status-pill .pulse-dot,
            .voice-caption .caret,
            .voice-btn--end.is-active::before {
                animation: none !important;
            }
        }
    </style>
}

<div class="voice-page">

    <div class="voice-atmosphere" aria-hidden="true"></div>

    <div class="voice-status-row">
        <span class="voice-status-pill">
            <span class="pulse-dot"></span>
            <span id="voiceStatusText">Hazır</span>
        </span>
        <span id="voiceTimer" class="voice-timer">00:00</span>
    </div>

    <div class="voice-center">

        <div class="voice-orb-wrap">
            <span class="voice-orb-ring voice-orb-ring--2"></span>
            <span class="voice-orb-ring voice-orb-ring--3"></span>
            <span class="voice-orb-core">
                <svg class="voice-orb-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="white" />
                </svg>
            </span>
        </div>

        <div class="voice-waveform" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>

        <p id="voiceCaption" class="voice-caption">
            Konuşmayı başlatmak için butona basın.
        </p>

        <p class="voice-speaking-indicator" aria-hidden="true">
            Aura konuşuyor<span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </p>

    </div>

    <div class="voice-controls">

        <button type="button"
                id="startVoiceBtn"
                class="voice-btn--end"
                aria-label="Konuşmayı başlat">

            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3Z"
                      stroke="white"
                      stroke-width="1.6" />

                <path d="M5 11a7 7 0 0 0 14 0M12 18v3"
                      stroke="white"
                      stroke-width="1.6"
                      stroke-linecap="round" />
            </svg>

        </button>
    </div>

    <a href="/Chat/Index/" class="voice-switch-mode">
        Yazıya geç
    </a>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const voiceConnection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .withAutomaticReconnect()
    .build();

    async function startVoiceConnection() {
        try {
            await voiceConnection.start();
            console.log("Voice SignalR bağlantısı kuruldu.");

        } catch (error) {
            console.error("SignalR bağlantı hatası:", error);
            setTimeout(startVoiceConnection, 3000);
        }
    }

    startVoiceConnection();

    let aiResponse = "";
    let currentVoiceConversationId = null;
    let currentAudio=null;

    voiceConnection.on(
        "ReceiveAiChunk",
        (conversationId, chunk, role) => {

            console.log("AI chunk:", chunk);
            currentVoiceConversationId = conversationId;
            aiResponse += chunk;
    voiceCaption.textContent = aiResponse;
        }
    );
    voiceConnection.on(
        "ReceiveAiCompleted",
        async (conversationId) => {
            console.log("AI cevap tamamlandı:", aiResponse);
             if (!aiResponse.trim()) {
        setVoiceState("ready");
        return;
    }

    setVoiceState("speaking");
    await textToSpeech(aiResponse);

        }
    );
        async function textToSpeech(text) {
        try {
            voiceStatusText.textContent = "Aura konuşuyor";
            voiceCaption.textContent = text;

            const response = await fetch("/Chat/TextToSpeech", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(text)
            });

            if (!response.ok) {
                throw new Error(`TTS hatası: ${response.status}`);
            }

            const audioBlob = await response.blob();

            const audioUrl = URL.createObjectURL(audioBlob);

            // Önceki ses varsa durdur
            if (currentAudio) {
                currentAudio.pause();
                currentAudio.currentTime = 0;
            }

            currentAudio = new Audio(audioUrl);

            currentAudio.onended = () => {
                URL.revokeObjectURL(audioUrl);

                setVoiceState("ready");
            };

            await currentAudio.play();

        } catch (error) {
            console.error("Text-to-Speech hatası:", error);

            voiceStatusText.textContent = "Hata";
            voiceCaption.textContent = "Ses oluşturulurken bir hata oluştu.";
        }
    }


    let mediaRecorder=null;
    let audioChunks=[];
    let isRecording=false;

    const startVoiceBtn=document.getElementById("startVoiceBtn");
    const voiceStatusText = document.getElementById("voiceStatusText");
    const voiceCaption = document.getElementById("voiceCaption");

    startVoiceBtn.addEventListener("click",async()=>{
        if(isRecording){
            stopRecording();
            return;
        }
        await startRecording();
    });

    async function startRecording(){
        try{
            const stream=await navigator.mediaDevices.getUserMedia({audio:true});
            mediaRecorder=new MediaRecorder(stream);

            audioChunks=[];

            mediaRecorder.ondataavailable=event=>{
                if(event.data.size>0){
                    audioChunks.push(event.data);
                }
            };
            mediaRecorder.onstop=async()=>{
                const audioBlob=new Blob(audioChunks,{type:mediaRecorder.mimeType});
                console.log("Ses kaydı hazır:", audioBlob);
                stream.getTracks().forEach(track => track.stop());
                await sendAudioToSpeechToText(audioBlob);
            };

            mediaRecorder.start();
            isRecording=true;
           setVoiceState("listening");

            startVoiceBtn.classList.add("is-active");
        }catch(error){
        console.error("Mikrofon hatası:", error);

            voiceStatusText.textContent = "Mikrofon kullanılamıyor";
            voiceCaption.textContent =
                "Mikrofon erişimine izin vermen gerekiyor.";
        }
    }

    async function sendAudioToSpeechToText(audioBlob) {

        try {

            voiceStatusText.textContent = "İşleniyor";
            voiceCaption.textContent = "Seni anlamaya çalışıyorum...";

            const formData = new FormData();

            formData.append(
                "audio",
                audioBlob,
                "voice.webm"
            );

            const response = await fetch("/Chat/SpeechToText", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                throw new Error(
                    `SpeechToText hatası: ${response.status}`
                );
            }

            const result = await response.json();

            console.log("STT sonucu:", result);

            const text = result.text;

            if (!text) {
                voiceStatusText.textContent = "Hazır";
                voiceCaption.textContent =
                    "Seni duyamadım, tekrar deneyebilirsin.";
                return;
            }

            voiceStatusText.textContent = "Sen konuşuyorsun";
            voiceCaption.textContent = text;

            console.log("Algılanan metin:", text);
                aiResponse = "";

    voiceStatusText.textContent = "Aura düşünüyor";

    await voiceConnection.invoke(
        "SendMessage",
        currentVoiceConversationId,
        text
    );

        } catch (error) {

            console.error("Speech-to-Text hatası:", error);

            voiceStatusText.textContent = "Hata";

            voiceCaption.textContent =
                "Ses işlenirken bir hata oluştu.";
        }
    }
     function stopRecording() {

        if (!mediaRecorder || !isRecording)
            return;

        mediaRecorder.stop();

        isRecording = false;

           setVoiceState("thinking");
    voiceCaption.textContent = "Seni anlamaya çalışıyorum...";

        startVoiceBtn.classList.remove("is-active");
    }

        function setVoiceState(state) {
        // Önce tüm durum sınıflarını temizle
        document.body.classList.remove(
            "voice-listening",
            "voice-thinking",
            "voice-speaking"
        );

        switch (state) {
            case "listening":
                document.body.classList.add("voice-listening");

                voiceStatusText.textContent = "Dinliyor";
                voiceCaption.textContent = "Seni dinliyorum...";
                break;

            case "thinking":
                document.body.classList.add("voice-thinking");

                voiceStatusText.textContent = "Aura düşünüyor";
                voiceCaption.textContent = "Cevabını hazırlıyorum...";
                break;

            case "speaking":
                document.body.classList.add("voice-speaking");

                voiceStatusText.textContent = "Aura konuşuyor";
                break;

            case "ready":
                voiceStatusText.textContent = "Hazır";
                voiceCaption.textContent = "Konuşmak için mikrofona dokun.";
                break;
        }
    }
</script>
