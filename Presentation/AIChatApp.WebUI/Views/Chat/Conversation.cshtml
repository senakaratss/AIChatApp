@model ConversationViewModel
@{
    ViewData["Title"] = "Conversation";
    ViewData["ChatTitle"] = Model.Title;
    Layout = "~/Views/Shared/_ChatLayout.cshtml";
}

<section class="message-thread" id="messageThread">
    @foreach (var msg in Model.Messages)
    {
        @if (msg.Role == "user")
        {
            <article class="message message--user">
                <div class="message-body">
                    <div class="message-meta message-meta--right">
                        <span class="message-author">Sen</span>
                        <span class="message-time">@msg.CreatedAt.ToString("HH:mm")</span>
                    </div>
                    <div class="message-bubble message-bubble--user">
                        <p>
                            @msg.Content
                        </p>
                    </div>
                </div>
                <span class="message-avatar message-avatar--user">@Model.UserInitials</span>
            </article>
        }
        else
        {
            <article class="message message--ai">
                <span class="message-avatar message-avatar--ai">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="currentColor" />
                    </svg>
                </span>
                <div class="message-body">
                    <div class="message-meta">
                        <span class="message-author">Aura Asistan</span>
                        <span class="message-time">@msg.CreatedAt.ToString("HH:mm")</span>
                    </div>
                    <div class="message-bubble message-bubble--ai">
                        <p>
                            @msg.Content
                        </p>
                    </div>
                    <div class="message-actions">
                        <button class="text-btn" type="button">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="9" y="9" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
                                <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.6" />
                            </svg>
                            Kopyala
                        </button>
                        <button class="text-btn" type="button">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 10v11M2 10h3v11H2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                <path d="M7 10l2.5-7a1.8 1.8 0 0 1 3.4 1.2L11.5 9H19a2 2 0 0 1 1.94 2.5l-1.6 7A2 2 0 0 1 17.4 20H7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            </svg>
                            Faydalı
                        </button>
                    </div>
                </div>
            </article>

        }
    }



