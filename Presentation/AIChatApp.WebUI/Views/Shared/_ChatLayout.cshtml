<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-top">
                <div class="brand">
                    <span class="brand-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="white" />
                        </svg>
                    </span>
                    <span class="brand-name">Aura</span>
                    <span class="brand-badge">PRO</span>
                    <button class="sidebar-close" id="sidebarClose" type="button" aria-label="Kenar çubuğunu kapat">&times;</button>
                </div>

                <a class="btn-new-chat" href="/Chat/Index/">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    </svg>
                    Yeni Sohbet
                </a>
                <a asp-controller="Voice" asp-action="Index" class="voice-entry-btn" aria-label="Sesli sohbeti başlat">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3Z" />
                        <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
                    </svg>
                    <span>Sesli sohbet</span>
                </a>
                <label class="search-box" for="conversationSearch">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                        <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <input type="text" id="conversationSearch" placeholder="Sohbetlerde ara...">
                </label>
            </div>

            @await Component.InvokeAsync("_ConversationListComponentPartial")

            @await Component.InvokeAsync("_UserProfileComponentPartial")


        </aside>

        <div class="sidebar-scrim" id="sidebarScrim"></div>

        <!-- ===================== MAIN COLUMN ===================== -->
        <div class="main-column">

            <!-- ============ CHAT HEADER ============ -->
            <header class="chat-header">
                <button class="icon-btn sidebar-toggle" id="sidebarToggle" type="button" aria-label="Kenar çubuğunu aç">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>

                <span class="header-pin" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" />
                        <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4" opacity="0.5" />
                    </svg>
                </span>

                <div class="header-title-group">
                    <div class="header-title-row">
                        <h1 class="header-title" id="chatTitle">@(ViewData["ChatTitle"] ?? "Yeni Sohbet")</h1>
                        <span class="status-pill"><span class="status-dot"></span>Aktif</span>
                    </div>
                    <p class="header-subtitle">Gerçek zamanlı senkronize oturum</p>
                </div>

                <div class="header-actions">
                    <!-- ============ MODEL SELECTOR (static/mock) ============ -->
                    <div class="model-selector" id="modelSelector">
                        <button class="model-selector-trigger" id="modelSelectorTrigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                            <span class="model-dot model-dot--gemini"></span>
                            <span id="selectedModelName">Gemini 1.5 Pro</span>
                            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>

                        <ul class="model-dropdown" id="modelDropdown" role="listbox">
                            <li class="model-option is-selected" role="option" aria-selected="true" data-model="Claude 3.5 Sonnet" data-dot="claude">
                                <span class="model-dot model-dot--claude"></span>
                                <span class="model-option-text">
                                    <span class="model-option-name">Claude 3.5 Sonnet</span>
                                    <span class="model-option-desc">Anthropic &middot; Yüksek Akıl Yürütme</span>
                                </span>
                                <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </li>
                            <li class="model-option" role="option" aria-selected="false" data-model="ChatGPT-4o" data-dot="gpt">
                                <span class="model-dot model-dot--gpt"></span>
                                <span class="model-option-text">
                                    <span class="model-option-name">ChatGPT-4o</span>
                                    <span class="model-option-desc">OpenAI &middot; Hızlı ve Esnek</span>
                                </span>
                                <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </li>
                            <li class="model-option" role="option" aria-selected="false" data-model="Gemini 1.5 Pro" data-dot="gemini">
                                <span class="model-dot model-dot--gemini"></span>
                                <span class="model-option-text">
                                    <span class="model-option-name">Gemini 1.5 Pro</span>
                                    <span class="model-option-desc">Google &middot; 1M Bağlam Penceresi</span>
                                </span>
                                <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </li>
                        </ul>
                    </div>

                    <button class="icon-btn" type="button" aria-label="Sohbeti indir">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3V15M12 15L7 10M12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M4 19H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                    </button>
                    <button class="icon-btn" type="button" aria-label="Diğer seçenekler">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="5" r="1.6" fill="currentColor" />
                            <circle cx="12" cy="12" r="1.6" fill="currentColor" />
                            <circle cx="12" cy="19" r="1.6" fill="currentColor" />
                        </svg>
                    </button>
                </div>
            </header>

            <!-- ============ PAGE BODY (Chat/Index.cshtml) ============ -->
            <main class="chat-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
